# ===================================================================
# SMKN 1 Pakuan Ratu - Environment Variables Configuration Template
# Salin file ini menjadi .env untuk penggunaan lokal / production.
# JANGAN PERNAH MENYIMPAN KREDENSIAL ASLI DI DALAM REPOSITORY GIT.
# ===================================================================

# Application Environment
NODE_ENV=development
PORT=5000

# Database Configuration (MySQL / MariaDB via Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:YOUR_DATABASE_PASSWORD@localhost:3306/smkn1pakuanratu"

# Authentication & Session Security
# Generate secure random secret for production (e.g. openssl rand -base64 32)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_CHANGE_IN_PRODUCTION
SESSION_SECRET=YOUR_SECURE_SESSION_SECRET_KEY_CHANGE_IN_PRODUCTION
COOKIE_SECRET=YOUR_SECURE_COOKIE_SECRET_KEY_CHANGE_IN_PRODUCTION
TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS & Domain Settings
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:5000"

# Media Storage Configuration
# Default mode: 'local' (backend/uploads), or configure cloud storage provider
STORAGE_DRIVER=local
UPLOAD_MAX_FILE_SIZE=5242880

# Cloudflare & Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
